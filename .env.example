# =================================================================
# NexusRAG — Production Environment Template
# Duplicate this file to .env and fill in your actual credentials.
# DO NOT commit .env to GitHub / Version Control!
# =================================================================

# --- Server Configuration ---
PORT=8000
HOST=0.0.0.0
JWT_SECRET=generate_a_random_64_character_secret_key_here
RATE_LIMIT_PER_MINUTE=60

# --- MongoDB Database (Atlas) ---
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGODB_DATABASE=nexus_rag

# --- Qdrant Vector DB ---
# Leave empty for local embedded Qdrant, or provide Cloud URL for persistent clustering:
QDRANT_URL=https://your-qdrant-cluster.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# --- AI LLM Providers ---
NVIDIA_API_KEY=your_nvidia_nim_api_key
NVDIA_API=your_nvidia_nim_api_key
GEMINI_API_KEY=your_google_gemini_api_key
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key

# --- Cloudinary (Document & Image Storage) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Razorpay Payment Gateway ---
RAZORPAY_KEY_ID=rzp_live_or_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# --- Email Notifications & OTP (Gmail or Brevo) ---
# Option 1: Gmail SMTP
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_google_app_password

# Option 2: Brevo (Sendinblue) API
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender@domain.com

# --- Frontend Build URL (Optional for Docker Compose) ---
VITE_API_URL=http://localhost:8000
